; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it can also be edited via code if needed.

[application]

config/name="Signal Lost"
config/description="Roguelike Tower Defense with Procedural Storytelling"
config/version="0.1.0"
run/main_scene=""
config/features=PackedStringArray("4.6")
config/icon="res://assets/ui/icon.svg"

[autoload]

GameManager="*res://scripts/autoload/game_manager.gd"
RunManager="*res://scripts/autoload/run_manager.gd"
MetaManager="*res://scripts/autoload/meta_manager.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

